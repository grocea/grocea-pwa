{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "grocea-pwa",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-27",
  "vars": {
    "BACKEND_ORIGIN": "https://grocea-backend.vercel.app"
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
